# Local literature-only models. No reproductive case data is sent to them.
LITERATURE_RAG_ENABLED=true
LITERATURE_GENERATION_PROVIDER=ollama
LITERATURE_MODEL_URL=http://127.0.0.1:11434
LITERATURE_GENERATION_MODEL=qwen2.5:1.5b
LITERATURE_EMBEDDING_MODEL=nomic-embed-text
# Native Windows runtime alternative:
# LITERATURE_GENERATION_PROVIDER=llama_cpp
# LITERATURE_MODEL_URL=http://127.0.0.1:8012
# LITERATURE_EMBEDDING_MODEL=hash-512-v1
# Without a model service, set LITERATURE_RAG_ENABLED=false and
# LITERATURE_EMBEDDING_MODEL=hash-512-v1 for explicit extractive retrieval.
# The offline index uses lexical hashing, not pretrained semantic embeddings.
