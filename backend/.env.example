# Backend environment settings
DATABASE_URL=postgresql://ovulite:ovulite_dev_password@db:5432/ovulite

# Connection pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600
SQLALCHEMY_ECHO=false

# API runtime
ENVIRONMENT=development
RATE_LIMIT_PER_MINUTE=120

# Google Sign-In (optional). Without this set, the frontend falls back to
# a "Continue with Google (Demo)" button that logs into a local demo
# account via POST /auth/google/mock — no real Google verification, and
# that fallback refuses to run when ENVIRONMENT=production.
#
# To enable real Google Sign-In:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create an OAuth 2.0 Client ID of type "Web application"
#   3. Add your frontend origin(s) under "Authorized JavaScript origins"
#      (e.g. http://localhost:5174 for local dev)
#   4. Copy the generated Client ID here AND into frontend/.env as
#      VITE_GOOGLE_CLIENT_ID (same value in both places — no Client Secret
#      is needed for this flow, since the frontend only ever sends a
#      signed ID token that the backend verifies against this Client ID).
GOOGLE_CLIENT_ID=
