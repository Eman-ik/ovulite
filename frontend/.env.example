# Frontend environment settings — copy to .env and fill in as needed.

VITE_API_URL=http://localhost:8000

# Google Sign-In (optional). Leave unset to use the "Continue with Google
# (Demo)" fallback button (calls POST /auth/google/mock on the backend —
# no real Google account needed, dev-only). Set this to enable the real
# Google Sign-In button instead; must match GOOGLE_CLIENT_ID in
# backend/.env exactly (see that file for setup steps).
VITE_GOOGLE_CLIENT_ID=
